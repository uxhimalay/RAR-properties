# Copy to .env.local (development) or set these in the host's environment (production).
# Every one of them is read on the server only; none is exposed to the browser.

# --- The admin. REQUIRED in production; without them the admin refuses every sign-in. ------------
# The passcode typed at /admin/login. Choose a long one; it is the only thing between the
# public internet and the content of this site.
ADMIN_PASSCODE=
# Signs the admin session cookie. Any long random string; changing it signs everyone out.
# Generate one with:  openssl rand -hex 32
ADMIN_SECRET=

# --- The site ------------------------------------------------------------------------------------
# The public origin, used to resolve social preview images to absolute URLs.
# e.g. https://www.arcsphere.ae
NEXT_PUBLIC_SITE_URL=

# --- Optional ------------------------------------------------------------------------------------
# Comma-separated hostnames that images may be loaded from, for pictures added in the admin by URL
# rather than uploaded. Empty means uploads only, which is the safe default.
# e.g. images.example.com,cdn.example.com
NEXT_IMAGE_HOSTS=

# Nothing else is required. The import screen's "let a model map the columns" button takes its API
# key in the screen itself, so no model key belongs in the environment.
